# 복사해서 .env 로 저장 후 값 입력 (.env 는 공유 금지)

# --- TTS ---
TTS_PROVIDER=gemini                    # gemini(무료, GEMINI_API_KEY 사용) | elevenlabs(유료 키 필요) | google
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                   # ElevenLabs > Voices > 보이스 옆 ⋯ > Copy voice ID
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_STABILITY=0.5               # v3: 0.0 Creative / 0.5 Natural / 1.0 Robust
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_SPEED=1.0
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128   # Creator 이상이면 mp3_44100_192 가능
GOOGLE_TTS_API_KEY=

# --- Gemini TTS (무료 등급) ---
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck                  # Puck(빠르고 경쾌) Fenrir(흥분형) Orus(단단함) Sadachbia(활기)

# --- Veo (Gemini API 또는 Vertex AI 중 하나) ---
GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
VEO_MODEL=veo-3.1-generate-preview

# --- 무료 스톡 영상 (Veo 결제 전 대안, 상업 이용 가능) ---
PEXELS_API_KEY=                        # https://www.pexels.com/api/ (무료)
PIXABAY_API_KEY=                       # https://pixabay.com/api/docs/ (무료)
